import { Button, CheckBox, ComboBox, Palette, Slider, SpinBox } from "std-widgets.slint";
import {
    BarChart,
    ChartDataset,
    ChartEngine,
    ChartPalette,
    ChartSlice,
    ChartSunburstItem,
    ChartTheme,
    ChartWaterfallStep,
    DumbbellChart,
    FunnelChart,
    GaugeChart,
    LineChart,
    ScatterChart,
    SunburstChart,
    TimeSeriesChart,
    WaterfallChart,
} from "@slintplot";
import { DarkModeButton, Look, ThemePicker } from "look.slint";
import { DragArea, ResizeHandles, WindowFrame, WindowsControls } from "window_frame.slint";
export { ChartEngine, WindowFrame }

export component Stress inherits Window {
    title: "SlintPlot stress test";
    // Shown in the taskbar, and in the Dock on macOS.
    icon: @image-url("../icon.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    // Windows and Linux: the app draws the frame, with rounded corners over
    // a transparent window. macOS: the window buttons sit in a title bar
    // strip above the header.
    no-frame: WindowFrame.drawn;
    background: WindowFrame.drawn ? transparent : Look.page;
    private property <length> corner-radius: WindowFrame.drawn && !WindowFrame.maximized ? 8px : 0px;
    private property <length> title-strip: WindowFrame.mac-titlebar ? 28px : 0px;
    private property <length> controls-width: WindowFrame.drawn ? 3 * 46px : 0px;

    // Values per dataset: the latest ones are kept and shown. A step of the
    // slider, from 1,000 to 10,000,000 in 1-2-5 steps, then unlimited, which
    // grows until 10,000,000 and stops.
    in-out property <float> window-position: 6;
    out property <int> window-step: round(root.window-position);
    private property <[string]> window-labels: ["1,000", "2,000", "5,000", "10,000", "20,000", "50,000", "100,000", "200,000", "500,000", "1,000,000", "2,000,000", "5,000,000", "10,000,000", "Unlimited"];
    // The step last applied, to resize once per step while dragging.
    private property <int> applied-window-step: 6;
    // The benchmark sets the value count directly; 0 uses `window-index`.
    in-out property <int> bench-count: 0;
    in-out property <int> dataset-count: 3;
    // 0: line, 1: bars, 2: time series, 3: scatter, 4: waterfall,
    // 5: dumbbell, 6: funnel, 7: sunburst, 8: gauge.
    in-out property <int> chart-type: 0;
    // Drawing options the benchmark varies; markers also switch the gauge's needle.
    in-out property <bool> show-points: false;
    in-out property <bool> smooth: false;
    in-out property <bool> fill: false;
    in-out property <bool> stepped: false;
    in-out property <bool> decimate: true;
    in-out property <bool> streaming: false;
    // Samples per second per dataset, by index into the picker.
    in-out property <int> sample-rate-index: 2;
    out property <int> sample-rate: [10, 100, 1000, 10000, 100000][root.sample-rate-index];
    // How the values are generated: 0 random walk, 1 sine, 2 square, 3 noise.
    in-out property <int> signal: 0;
    // The size of the random part of the signal, from 0 to 1.
    in-out property <float> noise: 0.5;
    // Occasional outliers, which decimation must keep.
    in-out property <bool> spikes: false;
    in-out property <bool> animated: true;
    // Line and time series charts, which have the line options.
    private property <bool> line-chart: root.chart-type == 0 || root.chart-type == 2;
    in-out property <float> view-start: 0;
    in-out property <float> view-end: 1;
    in-out property <bool> dark-mode: Palette.color-scheme == ColorScheme.dark;
    // Index into the theme picker.
    in-out property <int> theme;
    // The measurements in the status bar, and why streaming stopped.
    in property <string> stats;
    in-out property <string> notice;
    in property <[string]> labels;
    in-out property <[ChartDataset]> datasets;
    in property <[ChartWaterfallStep]> steps;
    in-out property <[ChartSlice]> stages;
    in-out property <[ChartSunburstItem]> sun;
    in property <float> gauge-value;

    // Rebuild the data for the chart type, window, datasets and signal.
    callback regenerate();
    // Apply a new window size, keeping the latest values when streaming.
    callback window-changed();
    // Apply the drawing options to the existing datasets.
    callback restyle();

    changed dark-mode => {
        Palette.color-scheme = self.dark-mode ? ColorScheme.dark : ColorScheme.light;
        root.apply-look();
    }
    // The chart sits on a card, so its backdrop (slice borders, label
    // backgrounds) is the card's color.
    function apply-look() {
        Look.dark = self.dark-mode;
        ChartTheme.background = Look.surface;
    }
    init => {
        self.apply-look();
    }
    changed theme => {
        ChartTheme.palette = self.theme == 0 ? ChartPalette.modern
            : self.theme == 1 ? ChartPalette.material
            : self.theme == 2 ? ChartPalette.corporate
            : self.theme == 3 ? ChartPalette.mono
            : ChartPalette.pastel;
    }

    function rebuild() {
        root.notice = "";
        root.view-start = 0;
        root.view-end = 1;
        root.regenerate();
    }

    Rectangle {
    border-radius: root.corner-radius;
    clip: WindowFrame.drawn;
    background: Look.page;

    // The empty parts of the top of the window move it.
    if WindowFrame.drawn || WindowFrame.mac-titlebar: DragArea {
        y: 0;
        height: root.title-strip + 72px;
    }

    VerticalLayout {
        padding: 24px;
        padding-top: root.title-strip + 18px;
        spacing: 16px;

        // The header: the logo, what the app is, and its look.
        HorizontalLayout {
            spacing: 16px;
            Image {
                y: 2px;
                height: 34px;
                // The logo is 720 by 218 pixels.
                width: 34px * 720 / 218;
                source: Look.dark ? @image-url("../logo-dark.png") : @image-url("../logo.png");
                image-fit: contain;
                accessible-role: image;
                accessible-label: "SlintPlot";
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                alignment: start;
                Text {
                    text: "Stress test";
                    font-size: 20px;
                    font-weight: 600;
                    color: Look.text;
                }
                Text {
                    text: "Stream data into a chart and watch the frame rate. Scroll on the chart to zoom, drag to pan, double-click to reset. Bars and scatter markers are one element each: keep them to 100,000 values. Waterfall, dumbbell, funnel and sunburst charts draw one element per value: keep them to 10,000.";
                    font-size: 13px;
                    color: Look.secondary;
                    wrap: word-wrap;
                }
            }
            VerticalLayout {
                alignment: start;
                ThemePicker {
                    width: 140px;
                    current <=> root.theme;
                }
            }
            VerticalLayout {
                alignment: start;
                DarkModeButton {
                    dark <=> root.dark-mode;
                }
            }
            // Room for the drawn window buttons.
            if WindowFrame.drawn: Rectangle {
                width: root.controls-width - 24px;
            }
        }

        // The controls, on a card of their own, in three labeled rows.
        Rectangle {
            border-radius: 12px;
            background: Look.surface;
            border-width: 1px;
            border-color: Look.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Look.dark ? #00000040 : #0000000f;

            VerticalLayout {
                padding: 12px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;

                // What is shown.
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        width: 70px;
                        text: "Data";
                        color: Look.secondary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        width: 140px;
                        model: ["Line", "Bars", "Time series", "Scatter", "Waterfall", "Dumbbell", "Funnel", "Sunburst", "Gauge"];
                        current-index <=> root.chart-type;
                        selected => {
                            root.rebuild();
                        }
                    }
                    Text {
                        text: "Datasets";
                        color: Look.text;
                        vertical-alignment: center;
                    }
                    SpinBox {
                        width: 90px;
                        minimum: 1;
                        maximum: 8;
                        value <=> root.dataset-count;
                        edited => {
                            root.rebuild();
                        }
                    }
                    Text {
                        text: "Window";
                        color: Look.text;
                        vertical-alignment: center;
                    }
                    Slider {
                        width: 240px;
                        minimum: 0;
                        maximum: root.window-labels.length - 1;
                        step: 1;
                        value <=> root.window-position;
                        changed => {
                            if root.window-step != root.applied-window-step {
                                root.applied-window-step = root.window-step;
                                root.window-changed();
                            }
                        }
                        // Snap the handle to the step.
                        released => {
                            root.window-position = root.window-step;
                        }
                    }
                    Text {
                        min-width: 90px;
                        text: root.window-labels[root.window-step];
                        color: Look.text;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }

                // How the data arrives.
                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text {
                        width: 70px;
                        text: "Stream";
                        color: Look.secondary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    Button {
                        width: 90px;
                        text: root.streaming ? "Pause" : "Stream";
                        primary: !root.streaming;
                        clicked => {
                            root.notice = "";
                            root.streaming = !root.streaming;
                        }
                    }
                    // Clears the data, so the window fills again from empty, and
                    // resets the zoom; the settings stay.
                    Button {
                        text: "Reset";
                        clicked => {
                            root.rebuild();
                        }
                    }
                    Text {
                        text: "Samples/s";
                        color: Look.text;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        width: 110px;
                        model: ["10", "100", "1,000", "10,000", "100,000"];
                        current-index <=> root.sample-rate-index;
                    }
                    Text {
                        text: "Signal";
                        color: Look.text;
                        vertical-alignment: center;
                    }
                    ComboBox {
                        width: 140px;
                        model: ["Random walk", "Sine", "Square", "Noise"];
                        current-index <=> root.signal;
                        selected => {
                            root.rebuild();
                        }
                    }
                    Text {
                        text: "Noise";
                        color: Look.text;
                        vertical-alignment: center;
                    }
                    Slider {
                        width: 140px;
                        minimum: 0;
                        maximum: 1;
                        value <=> root.noise;
                        released => {
                            root.rebuild();
                        }
                    }
                    CheckBox {
                        text: "Spikes";
                        checked <=> root.spikes;
                        toggled => {
                            root.rebuild();
                        }
                    }
                }

                // How the chart draws, for the charts that have the options.
                HorizontalLayout {
                    spacing: 16px;
                    alignment: start;
                    Text {
                        width: 70px - 6px;
                        text: "Drawing";
                        color: Look.secondary;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                    CheckBox {
                        text: "Points";
                        enabled: root.chart-type == 0 || root.chart-type == 2 || root.chart-type == 8;
                        checked <=> root.show-points;
                    }
                    CheckBox {
                        text: "Smooth";
                        enabled: root.line-chart;
                        checked <=> root.smooth;
                        toggled => {
                            root.restyle();
                        }
                    }
                    CheckBox {
                        text: "Fill";
                        enabled: root.line-chart;
                        checked <=> root.fill;
                        toggled => {
                            root.restyle();
                        }
                    }
                    CheckBox {
                        text: "Steps";
                        enabled: root.line-chart;
                        checked <=> root.stepped;
                        toggled => {
                            root.restyle();
                        }
                    }
                    CheckBox {
                        text: "Decimate";
                        enabled: root.line-chart;
                        checked <=> root.decimate;
                    }
                    CheckBox {
                        text: "Animate";
                        checked <=> root.animated;
                    }
                }
            }
        }

        // The chart, on a card, with the measurements in its footer.
        Rectangle {
            vertical-stretch: 1;
            border-radius: 12px;
            background: Look.surface;
            border-width: 1px;
            border-color: Look.border;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 2px;
            drop-shadow-color: Look.dark ? #00000040 : #0000000f;

            VerticalLayout {
                VerticalLayout {
                    vertical-stretch: 1;
                    padding: 16px;

                    if root.chart-type == 0: LineChart {
                        vertical-stretch: 1;
                        labels: root.labels;
                        datasets <=> root.datasets;
                        animated: root.animated;
                        begin-at-zero: false;
                        show-points: root.show-points;
                        decimate: root.decimate;
                        zoom-enabled: true;
                        view-start <=> root.view-start;
                        view-end <=> root.view-end;
                    }
                    if root.chart-type == 1: BarChart {
                        vertical-stretch: 1;
                        labels: root.labels;
                        datasets <=> root.datasets;
                        animated: root.animated;
                        zoom-enabled: true;
                        view-start <=> root.view-start;
                        view-end <=> root.view-end;
                    }
                    if root.chart-type == 2: TimeSeriesChart {
                        vertical-stretch: 1;
                        datasets <=> root.datasets;
                        animated: root.animated;
                        // One point per minute from this time.
                        time-origin: { year: 2026, month: 1, day: 1 };
                        show-points: root.show-points;
                        decimate: root.decimate;
                        zoom-enabled: true;
                        view-start <=> root.view-start;
                        view-end <=> root.view-end;
                    }
                    if root.chart-type == 3: ScatterChart {
                        vertical-stretch: 1;
                        datasets <=> root.datasets;
                        animated: root.animated;
                        zoom-enabled: true;
                        view-start <=> root.view-start;
                        view-end <=> root.view-end;
                    }
                    if root.chart-type == 4: WaterfallChart {
                        vertical-stretch: 1;
                        steps: root.steps;
                        animated: root.animated;
                    }
                    if root.chart-type == 5: DumbbellChart {
                        vertical-stretch: 1;
                        labels: root.labels;
                        datasets <=> root.datasets;
                        animated: root.animated;
                    }
                    if root.chart-type == 6: FunnelChart {
                        vertical-stretch: 1;
                        stages <=> root.stages;
                        animated: root.animated;
                    }
                    if root.chart-type == 7: SunburstChart {
                        vertical-stretch: 1;
                        items <=> root.sun;
                        animated: root.animated;
                    }
                    if root.chart-type == 8: GaugeChart {
                        vertical-stretch: 1;
                        value: root.gauge-value;
                        show-needle: root.show-points;
                        animated: root.animated;
                        value-decimals: 1;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Look.border;
                }
                // What is shown, how fast it draws, and why streaming stopped.
                HorizontalLayout {
                    padding: 10px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 12px;
                    Text {
                        text: root.stats;
                        color: Look.secondary;
                        font-family: "Menlo";
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                    Text {
                        horizontal-stretch: 1;
                        text: root.notice;
                        color: #e5484d;
                        font-size: 12px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    if WindowFrame.drawn: WindowsControls {
        width: root.controls-width;
        x: root.width - self.width;
        y: 0;
        height: 32px;
    }
    }

    if WindowFrame.drawn && !WindowFrame.maximized: Rectangle {
        border-radius: root.corner-radius;
        border-width: 1px;
        border-color: root.dark-mode ? #ffffff26 : #00000026;
    }

    if WindowFrame.drawn && !WindowFrame.maximized: ResizeHandles { }
}
