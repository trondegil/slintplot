import { ChartEngine, ChartFormat, ChartLegendItem, ChartSegmentedRingItem, ChartSegmentedRingLayout, ChartSlice } from "engine.slint";
import { ChartTheme, ChartTexts } from "theme.slint";
import { ChartLegendPosition, LegendFrame } from "legend.slint";
import { TooltipFrame, TooltipLine } from "tooltip.slint";

// A segmented ring chart: concentric rings cut into short segments, each a
// unit of the total. The items fill the segments in turn from
// `start-angle`, sweeping round across all the rings, or ring by ring from
// the outside; the segments past the last item stay empty, as a faint
// track. The total, or the hovered item, is written
// in the middle.
export component SegmentedRingChart {
    in-out property <[ChartSlice]> slices;
    in property <string> title;
    // The number of rings, and of segments in the outer ring; inner rings
    // have fewer, so that the segments keep their length.
    in property <int> rings: 5;
    in property <int> segments: 60;
    // The value of all segments together; 0 for the total of the values, so
    // that they fill every segment.
    in property <float> max-value: 0;
    // Where the first segment starts, in degrees clockwise from 12 o'clock,
    // and which way the items fill the rings.
    in property <float> start-angle: 0;
    in property <bool> clockwise: true;
    // Fill each ring before the next, from the outside, rather than sweep
    // round across all of them.
    in property <bool> fill-by-ring: false;
    // The empty middle, as a share of the radius.
    in property <float> cutout: 0.45;
    // The gap between the rings, as a share of their width, and between the
    // segments, as a share of the angle each takes.
    in property <float> ring-gap: 0.5;
    in property <float> segment-gap: 0.3;
    // One color for every item without its own; leave unset (transparent)
    // for the theme's colors in turn.
    in property <color> color;
    // The empty segments; leave unset for a faint gray.
    in property <color> track-color;
    // The text in the middle: the value, or the total when empty, and a
    // caption under it. Hovering an item shows its value and label instead.
    in property <bool> show-center: true;
    in property <string> center-value;
    in property <string> center-label;
    // A dot at the start, outside the outer ring.
    in property <bool> show-marker: true;
    // A soft glow of the first color in the middle.
    in property <bool> glow: false;
    in property <bool> show-legend: true;
    in property <ChartLegendPosition> legend-position: ChartLegendPosition.bottom;
    in property <bool> show-tooltip: true;
    // Light the segments up in turn when the chart appears, and move the
    // items' ends when the values change.
    in property <bool> animated: true;
    // How values are written: a prefix and suffix, and a fixed number of
    // decimals (-1: automatic).
    in property <string> value-prefix;
    in property <string> value-suffix;
    in property <int> value-decimals: -1;

    // The item under the mouse, or selected with the arrow keys; -1 if none.
    out property <int> hovered-index: chart.visible.length == 0 ? -1
        : touch.has-hover ? ChartEngine.segmented-ring-hit(chart, touch.mouse-x / 1px, touch.mouse-y / 1px)
        : keys.has-focus && root.key-position >= 0 ? chart.visible[min(root.key-position, chart.visible.length - 1)]
        : -1;

    callback slice-clicked(index: int);
    callback legend-toggled(index: int);

    accessible-role: image;
    accessible-label: root.title;
    accessible-description: root.hovered-index >= 0 ? root.describe(root.hovered-index)
        : root.center-text() + (root.center-label != "" ? " " + root.center-label : "");

    // The selected item's place among the visible ones.
    private property <int> key-position: -1;
    private property <ChartFormat> format: {
        prefix: root.value-prefix,
        suffix: root.value-suffix,
        decimals: root.value-decimals,
    };
    pure function share(index: int) -> string {
        ChartEngine.format-percent(root.slices[index].value / max(chart.total, 0.000001) * 100, 1)
    }
    pure function describe(index: int) -> string {
        root.slices[index].label + ": " + ChartEngine.format-value(root.slices[index].value, root.format)
            + " (" + root.share(index) + ")"
    }
    pure function center-text() -> string {
        root.center-value != "" ? root.center-value : ChartEngine.format-value(chart.total, root.format)
    }

    private property <float> progress: 0;
    animate progress {
        duration: root.animated ? ChartTheme.animation-duration : 0ms;
        easing: ease-out-quart;
    }
    init => {
        progress = 1;
    }
    private property <color> track: root.track-color.alpha > 0 ? root.track-color
        : ChartTheme.text-color.with-alpha(ChartTheme.dark ? 0.12 : 0.09);
    private property <[color]> palette: root.color.alpha > 0 ? [root.color] : ChartTheme.colors;
    private property <[ChartLegendItem]> legend: ChartEngine.slice-legend(root.slices, root.palette);
    private property <ChartSegmentedRingLayout> chart: ChartEngine.segmented-ring-layout({
        slices: root.slices,
        width: area.width / 1px,
        height: area.height / 1px,
        start-angle: root.start-angle,
        clockwise: root.clockwise,
        by-ring: root.fill-by-ring,
        rings: root.rings,
        segments: root.segments,
        max: root.max-value,
        cutout: root.cutout,
        ring-gap: root.ring-gap,
        segment-gap: root.segment-gap,
        marker: root.show-marker,
        palette: root.palette,
    });
    // How far the items reach as they light up.
    private property <float> shown: chart.filled * root.progress;
    private property <color> first-color: chart.visible.length > 0 ? chart.items[chart.visible[0]].color : ChartTheme.colors[0];

    min-width: 120px;
    min-height: 120px;
    preferred-width: 360px;
    preferred-height: 400px;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        if root.title != "": Text {
            text: root.title;
            color: ChartTheme.text-color;
            font-size: ChartTheme.title-font-size;
            font-weight: 600;
            horizontal-alignment: center;
        }

        LegendFrame {
            vertical-stretch: 1;
            items: root.legend;
            show-legend: root.show-legend;
            position: root.legend-position;
            toggled(index) => {
                root.slices[index].hidden = !root.slices[index].hidden;
                root.legend-toggled(index);
            }

            area := Rectangle {
                horizontal-stretch: 1;

                if root.glow && chart.inner-radius > 0: Rectangle {
                    x: (chart.center-x - chart.radius) * 1px;
                    y: (chart.center-y - chart.radius) * 1px;
                    width: chart.radius * 2px;
                    height: chart.radius * 2px;
                    border-radius: self.width / 2;
                    // Fades out by the circle's edge, before the corners.
                    background: @radial-gradient(circle, root.first-color.with-alpha(ChartTheme.dark ? 0.16 : 0.12) 0%, root.first-color.with-alpha(0.04) 45%, transparent 68%);
                }

                Path {
                    viewbox-width: area.width / 1px;
                    viewbox-height: area.height / 1px;
                    width: area.width;
                    height: area.height;
                    fit: fill;
                    commands: ChartEngine.segmented-ring-path(chart, 0, chart.capacity);
                    fill: root.track;
                }

                // Repeated over the items themselves, so that an item keeps
                // its element, and its ends move, when its value changes.
                for slice[i] in root.slices: Path {
                    property <ChartSegmentedRingItem> item: i < chart.items.length ? chart.items[i] : { position: -1 };
                    property <bool> dimmed: root.hovered-index >= 0 && root.hovered-index != i;
                    property <float> from: self.item.from;
                    property <float> to: self.item.to;
                    animate from, to {
                        duration: root.animated ? 500ms : 0ms;
                        easing: ease-in-out;
                    }
                    visible: self.item.visible;
                    viewbox-width: area.width / 1px;
                    viewbox-height: area.height / 1px;
                    width: area.width;
                    height: area.height;
                    fit: fill;
                    commands: ChartEngine.segmented-ring-path(chart, min(self.from, root.shown), min(self.to, root.shown));
                    fill: self.item.color;
                    opacity: self.dimmed ? 0.3 : 1;
                    animate opacity { duration: 120ms; }
                }

                if chart.marker-size > 0: Rectangle {
                    x: (chart.marker-x - chart.marker-size / 2) * 1px;
                    y: (chart.marker-y - chart.marker-size / 2) * 1px;
                    width: chart.marker-size * 1px;
                    height: self.width;
                    border-radius: self.width / 2;
                    background: root.first-color;
                }

                if root.show-center && chart.inner-radius > 12: VerticalLayout {
                    property <length> room: chart.inner-radius * 1.5px;
                    property <bool> hovered: root.hovered-index >= 0 && root.hovered-index < root.slices.length;
                    x: chart.center-x * 1px - self.room / 2;
                    y: chart.center-y * 1px - self.preferred-height / 2;
                    width: self.room;
                    height: self.preferred-height;
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: hovered ? ChartEngine.format-value(root.slices[root.hovered-index].value, root.format) : root.center-text();
                        color: hovered ? chart.items[root.hovered-index].color : ChartTheme.text-color;
                        font-size: clamp(room * 0.3, 12px, 64px);
                        font-weight: 700;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    if hovered || root.center-label != "": Text {
                        text: hovered ? root.slices[root.hovered-index].label : root.center-label;
                        color: ChartTheme.text-color.with-alpha(0.75);
                        font-size: clamp(room * 0.09, 9px, ChartTheme.font-size * 1.3);
                        font-weight: 600;
                        letter-spacing: 1px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }

                // Keyboard: the arrow keys move through the items, Enter
                // clicks the selected one.
                keys := FocusScope {
                    key-pressed(event) => {
                        let count = chart.visible.length;
                        if count == 0 {
                            return reject;
                        }
                        let current = root.key-position < 0 ? 0 : min(root.key-position, count - 1);
                        if event.text == Key.DownArrow || event.text == Key.RightArrow {
                            root.key-position = root.key-position < 0 ? 0 : mod(current + 1, count);
                        } else if event.text == Key.UpArrow || event.text == Key.LeftArrow {
                            root.key-position = mod(current - 1 + count, count);
                        } else if event.text == Key.Home {
                            root.key-position = 0;
                        } else if event.text == Key.End {
                            root.key-position = count - 1;
                        } else if event.text == Key.Return && root.key-position >= 0 {
                            root.slice-clicked(chart.visible[current]);
                        } else {
                            return reject;
                        }
                        accept
                    }

                    touch := TouchArea {
                        mouse-cursor: root.hovered-index >= 0 ? pointer : default;
                        clicked => {
                            keys.focus();
                            if root.hovered-index >= 0 {
                                root.key-position = chart.items[root.hovered-index].position;
                                root.slice-clicked(root.hovered-index);
                            }
                        }
                    }
                }

                if keys.has-focus: Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: ChartTheme.axis-color;
                }

                if root.show-tooltip && touch.has-hover && root.hovered-index >= 0 && root.hovered-index < chart.items.length: TooltipFrame {
                    property <int> index: root.hovered-index;
                    x: touch.mouse-x + 14px + self.width > area.width ? max(0px, touch.mouse-x - 14px - self.width) : touch.mouse-x + 14px;
                    y: clamp(touch.mouse-y - self.height / 2, 0px, max(0px, area.height - self.height));
                    width: self.preferred-width;
                    height: self.preferred-height;
                    title: root.slices[self.index].label;

                    TooltipLine {
                        swatch: chart.items[index].color;
                        text: ChartEngine.format-value(root.slices[index].value, root.format) + " (" + root.share(index) + ")";
                        bold: true;
                    }
                }
            }
        }
    }
}
