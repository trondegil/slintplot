// How numbers and dates are written: separators, month and weekday names,
// and date patterns. Set `ChartTheme.language`, or assign your own
// `ChartLocale` to `ChartTheme.locale`.

// Number and date conventions, and the charts' few built-in texts. Empty
// fields, and name lists of the wrong length, are English. Date patterns use {d} for the day, {MMM} for the short
// month name and {yyyy} for the year; `date-time` combines {date} and {time}.
export struct ChartLocale {
    // Before the decimals: "." or ",".
    decimal: string,
    // Between groups of thousands, such as "," or "." or "\u{a0}" (a no-break
    // space). Leave both separators empty for English; set only `decimal`
    // for no grouping.
    group: string,
    // After a percentage: "%" or "\u{a0}%".
    percent: string,
    // The 12 short month names, January first.
    months: [string],
    // The 7 short weekday names, Monday first.
    weekdays: [string],
    // A day in a month: "{MMM} {d}" (Oct 25) or "{d}. {MMM}" (25. Okt.).
    day-month: string,
    // A month in a year: "{MMM} {yyyy}".
    month-year: string,
    // A full date: "{MMM} {d}, {yyyy}".
    date: string,
    // A date with a time: "{date}, {time}".
    date-time: string,
    // A 12-hour clock, with `am` and `pm` ("AM" and "PM" when empty).
    hour12: bool,
    am: string,
    pm: string,
    // Calendar heatmaps: the ends of the legend ("Less", "More").
    less: string,
    more: string,
    // Heatmap tooltips: a missing value ("No data").
    no-data: string,
    // Waterfall charts: the default legend ("Increase", "Decrease",
    // "Total"), and the tooltip's "Running total".
    increase: string,
    decrease: string,
    total: string,
    running-total: string,
    // Dumbbell tooltips: "Change".
    change: string,
    // Funnel tooltips: "{value} of the first stage", "{value} of the
    // previous stage".
    of-first-stage: string,
    of-previous-stage: string,
    // Calendar heatmap tooltips: "{value} on {date}".
    on-date: string,
    // Gauge and bullet chart legends: a band without a label ("Up to
    // {value}").
    up-to: string,
    // Bullet chart tooltips: "Target", "{value} of target", and a value
    // beyond the axis ("Off the scale").
    target: string,
    of-target: string,
    off-scale: string,
}

// The languages with built-in conventions and texts.
export enum ChartLanguage {
    english,
    chinese,
    danish,
    dutch,
    finnish,
    french,
    german,
    italian,
    japanese,
    norwegian,
    polish,
    portuguese,
    spanish,
    swedish,
}

// The built-in conventions of each language, after CLDR.
export global ChartLocales {
    public pure function of(language: ChartLanguage) -> ChartLocale {
        if language == ChartLanguage.chinese {
            return {
                months: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
                weekdays: ["周一", "周二", "周三", "周四", "周五", "周六", "周日"],
                day-month: "{MMM}{d}日", month-year: "{yyyy}年{MMM}", date: "{yyyy}年{MMM}{d}日", date-time: "{date} {time}",
                less: "少", more: "多", no-data: "无数据",
                increase: "增加", decrease: "减少", total: "合计", running-total: "累计", change: "变化",
                of-first-stage: "占第一阶段的{value}", of-previous-stage: "占上一阶段的{value}", on-date: "{date}：{value}",
                up-to: "最高{value}", target: "目标", of-target: "目标的{value}", off-scale: "超出刻度",
            };
        }
        if language == ChartLanguage.danish {
            return {
                decimal: ",", group: ".", percent: "\u{a0}%",
                months: ["jan.", "feb.", "mar.", "apr.", "maj", "jun.", "jul.", "aug.", "sep.", "okt.", "nov.", "dec."],
                weekdays: ["man.", "tir.", "ons.", "tor.", "fre.", "lør.", "søn."],
                day-month: "{d}. {MMM}", month-year: "{MMM} {yyyy}", date: "{d}. {MMM} {yyyy}", date-time: "{date} {time}",
                less: "Mindre", more: "Mere", no-data: "Ingen data",
                increase: "Stigning", decrease: "Fald", total: "I alt", running-total: "Løbende total", change: "Ændring",
                of-first-stage: "{value} af første trin", of-previous-stage: "{value} af forrige trin", on-date: "{value} den {date}",
                up-to: "Op til {value}", target: "Mål", of-target: "{value} af målet", off-scale: "Uden for skalaen",
            };
        }
        if language == ChartLanguage.dutch {
            return {
                decimal: ",", group: ".", percent: "%",
                months: ["jan", "feb", "mrt", "apr", "mei", "jun", "jul", "aug", "sep", "okt", "nov", "dec"],
                weekdays: ["ma", "di", "wo", "do", "vr", "za", "zo"],
                day-month: "{d} {MMM}", month-year: "{MMM} {yyyy}", date: "{d} {MMM} {yyyy}", date-time: "{date} {time}",
                less: "Minder", more: "Meer", no-data: "Geen gegevens",
                increase: "Toename", decrease: "Afname", total: "Totaal", running-total: "Lopend totaal", change: "Verandering",
                of-first-stage: "{value} van de eerste fase", of-previous-stage: "{value} van de vorige fase", on-date: "{value} op {date}",
                up-to: "Tot {value}", target: "Doel", of-target: "{value} van het doel", off-scale: "Buiten de schaal",
            };
        }
        if language == ChartLanguage.finnish {
            return {
                decimal: ",", group: "\u{a0}", percent: "\u{a0}%",
                months: ["tammik.", "helmik.", "maalisk.", "huhtik.", "toukok.", "kesäk.", "heinäk.", "elok.", "syysk.", "lokak.", "marrask.", "jouluk."],
                weekdays: ["ma", "ti", "ke", "to", "pe", "la", "su"],
                day-month: "{d}. {MMM}", month-year: "{MMM} {yyyy}", date: "{d}. {MMM} {yyyy}", date-time: "{date} {time}",
                less: "Vähemmän", more: "Enemmän", no-data: "Ei tietoja",
                increase: "Lisäys", decrease: "Vähennys", total: "Yhteensä", running-total: "Kertymä", change: "Muutos",
                of-first-stage: "{value} ensimmäisestä vaiheesta", of-previous-stage: "{value} edellisestä vaiheesta", on-date: "{date}: {value}",
                up-to: "Enintään {value}", target: "Tavoite", of-target: "{value} tavoitteesta", off-scale: "Asteikon ulkopuolella",
            };
        }
        if language == ChartLanguage.french {
            return {
                decimal: ",", group: "\u{a0}", percent: "\u{a0}%",
                months: ["janv.", "févr.", "mars", "avr.", "mai", "juin", "juil.", "août", "sept.", "oct.", "nov.", "déc."],
                weekdays: ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."],
                day-month: "{d} {MMM}", month-year: "{MMM} {yyyy}", date: "{d} {MMM} {yyyy}", date-time: "{date} {time}",
                less: "Moins", more: "Plus", no-data: "Aucune donnée",
                increase: "Hausse", decrease: "Baisse", total: "Total", running-total: "Total cumulé", change: "Variation",
                of-first-stage: "{value} de la première étape", of-previous-stage: "{value} de l’étape précédente", on-date: "{value} le {date}",
                up-to: "Jusqu’à {value}", target: "Objectif", of-target: "{value} de l’objectif", off-scale: "Hors échelle",
            };
        }
        if language == ChartLanguage.german {
            return {
                decimal: ",", group: ".", percent: "\u{a0}%",
                months: ["Jan.", "Feb.", "März", "Apr.", "Mai", "Juni", "Juli", "Aug.", "Sept.", "Okt.", "Nov.", "Dez."],
                weekdays: ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"],
                day-month: "{d}. {MMM}", month-year: "{MMM} {yyyy}", date: "{d}. {MMM} {yyyy}", date-time: "{date}, {time}",
                less: "Weniger", more: "Mehr", no-data: "Keine Daten",
                increase: "Zunahme", decrease: "Abnahme", total: "Summe", running-total: "Laufende Summe", change: "Änderung",
                of-first-stage: "{value} der ersten Stufe", of-previous-stage: "{value} der vorherigen Stufe", on-date: "{value} am {date}",
                up-to: "Bis {value}", target: "Ziel", of-target: "{value} des Ziels", off-scale: "Außerhalb der Skala",
            };
        }
        if language == ChartLanguage.italian {
            return {
                decimal: ",", group: ".", percent: "%",
                months: ["gen", "feb", "mar", "apr", "mag", "giu", "lug", "ago", "set", "ott", "nov", "dic"],
                weekdays: ["lun", "mar", "mer", "gio", "ven", "sab", "dom"],
                day-month: "{d} {MMM}", month-year: "{MMM} {yyyy}", date: "{d} {MMM} {yyyy}", date-time: "{date}, {time}",
                less: "Meno", more: "Più", no-data: "Nessun dato",
                increase: "Aumento", decrease: "Diminuzione", total: "Totale", running-total: "Totale progressivo", change: "Variazione",
                of-first-stage: "{value} della prima fase", of-previous-stage: "{value} della fase precedente", on-date: "{value} il {date}",
                up-to: "Fino a {value}", target: "Obiettivo", of-target: "{value} dell’obiettivo", off-scale: "Fuori scala",
            };
        }
        if language == ChartLanguage.japanese {
            return {
                months: ["1月", "2月", "3月", "4月", "5月", "6月", "7月", "8月", "9月", "10月", "11月", "12月"],
                weekdays: ["月", "火", "水", "木", "金", "土", "日"],
                day-month: "{MMM}{d}日", month-year: "{yyyy}年{MMM}", date: "{yyyy}年{MMM}{d}日", date-time: "{date} {time}",
                less: "少ない", more: "多い", no-data: "データなし",
                increase: "増加", decrease: "減少", total: "合計", running-total: "累計", change: "変化",
                of-first-stage: "最初の段階の{value}", of-previous-stage: "前の段階の{value}", on-date: "{date}：{value}",
                up-to: "{value}まで", target: "目標", of-target: "目標の{value}", off-scale: "目盛りの範囲外",
            };
        }
        if language == ChartLanguage.norwegian {
            return {
                decimal: ",", group: "\u{a0}", percent: "\u{a0}%",
                months: ["jan.", "feb.", "mar.", "apr.", "mai", "jun.", "jul.", "aug.", "sep.", "okt.", "nov.", "des."],
                weekdays: ["man.", "tir.", "ons.", "tor.", "fre.", "lør.", "søn."],
                day-month: "{d}. {MMM}", month-year: "{MMM} {yyyy}", date: "{d}. {MMM} {yyyy}", date-time: "{date}, {time}",
                less: "Mindre", more: "Mer", no-data: "Ingen data",
                increase: "Økning", decrease: "Nedgang", total: "Totalt", running-total: "Løpende total", change: "Endring",
                of-first-stage: "{value} av første trinn", of-previous-stage: "{value} av forrige trinn", on-date: "{value} den {date}",
                up-to: "Opptil {value}", target: "Mål", of-target: "{value} av målet", off-scale: "Utenfor skalaen",
            };
        }
        if language == ChartLanguage.polish {
            return {
                decimal: ",", group: "\u{a0}", percent: "%",
                months: ["sty", "lut", "mar", "kwi", "maj", "cze", "lip", "sie", "wrz", "paź", "lis", "gru"],
                weekdays: ["pon.", "wt.", "śr.", "czw.", "pt.", "sob.", "niedz."],
                day-month: "{d} {MMM}", month-year: "{MMM} {yyyy}", date: "{d} {MMM} {yyyy}", date-time: "{date}, {time}",
                less: "Mniej", more: "Więcej", no-data: "Brak danych",
                increase: "Wzrost", decrease: "Spadek", total: "Suma", running-total: "Suma narastająco", change: "Zmiana",
                of-first-stage: "{value} pierwszego etapu", of-previous-stage: "{value} poprzedniego etapu", on-date: "{date}: {value}",
                up-to: "Do {value}", target: "Cel", of-target: "{value} celu", off-scale: "Poza skalą",
            };
        }
        if language == ChartLanguage.portuguese {
            return {
                decimal: ",", group: ".", percent: "%",
                months: ["jan.", "fev.", "mar.", "abr.", "mai.", "jun.", "jul.", "ago.", "set.", "out.", "nov.", "dez."],
                weekdays: ["seg.", "ter.", "qua.", "qui.", "sex.", "sáb.", "dom."],
                day-month: "{d} de {MMM}", month-year: "{MMM} de {yyyy}", date: "{d} de {MMM} de {yyyy}", date-time: "{date}, {time}",
                less: "Menos", more: "Mais", no-data: "Sem dados",
                increase: "Aumento", decrease: "Diminuição", total: "Total", running-total: "Total acumulado", change: "Variação",
                of-first-stage: "{value} da primeira etapa", of-previous-stage: "{value} da etapa anterior", on-date: "{value} em {date}",
                up-to: "Até {value}", target: "Meta", of-target: "{value} da meta", off-scale: "Fora da escala",
            };
        }
        if language == ChartLanguage.spanish {
            return {
                decimal: ",", group: ".", percent: "\u{a0}%",
                months: ["ene", "feb", "mar", "abr", "may", "jun", "jul", "ago", "sept", "oct", "nov", "dic"],
                weekdays: ["lun", "mar", "mié", "jue", "vie", "sáb", "dom"],
                day-month: "{d} {MMM}", month-year: "{MMM} {yyyy}", date: "{d} {MMM} {yyyy}", date-time: "{date}, {time}",
                less: "Menos", more: "Más", no-data: "Sin datos",
                increase: "Aumento", decrease: "Disminución", total: "Total", running-total: "Total acumulado", change: "Cambio",
                of-first-stage: "{value} de la primera etapa", of-previous-stage: "{value} de la etapa anterior", on-date: "{value} el {date}",
                up-to: "Hasta {value}", target: "Objetivo", of-target: "{value} del objetivo", off-scale: "Fuera de escala",
            };
        }
        if language == ChartLanguage.swedish {
            return {
                decimal: ",", group: "\u{a0}", percent: "\u{a0}%",
                months: ["jan.", "feb.", "mars", "apr.", "maj", "juni", "juli", "aug.", "sep.", "okt.", "nov.", "dec."],
                weekdays: ["mån", "tis", "ons", "tors", "fre", "lör", "sön"],
                day-month: "{d} {MMM}", month-year: "{MMM} {yyyy}", date: "{d} {MMM} {yyyy}", date-time: "{date} {time}",
                less: "Mindre", more: "Mer", no-data: "Inga data",
                increase: "Ökning", decrease: "Minskning", total: "Totalt", running-total: "Löpande summa", change: "Förändring",
                of-first-stage: "{value} av första steget", of-previous-stage: "{value} av föregående steg", on-date: "{value} den {date}",
                up-to: "Upp till {value}", target: "Mål", of-target: "{value} av målet", off-scale: "Utanför skalan",
            };
        }
        // English: every field falls back to it.
        { }
    }
}
