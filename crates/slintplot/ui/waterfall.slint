import { ChartAxis, ChartChange, ChartEngine, ChartFormat, ChartKind, ChartLegendItem, ChartWaterfallBar, ChartWaterfallLayout, ChartWaterfallStep } from "engine.slint";
import { ChartTheme } from "theme.slint";
import { ChartLegendPosition, LegendFrame } from "legend.slint";

// A waterfall chart: each step's bar floats from the running total before it
// to the total after it, colored by whether it adds or takes away. Steps
// marked `total` are bars from zero to the running total.
export component WaterfallChart {
    in property <[ChartWaterfallStep]> steps;
    in property <string> title;
    // The legend explains the three colors.
    in property <bool> show-legend: true;
    in property <ChartLegendPosition> legend-position: ChartLegendPosition.top;
    in property <bool> show-tooltip: true;
    // Grow the bars in when the chart appears, and move them to new values.
    in property <bool> animated: true;
    // Write each change, or total, above its bar.
    in property <bool> show-values: false;
    // Lines from each bar's end to the next bar.
    in property <bool> show-connectors: true;
    in property <color> increase-color: ChartTheme.dark ? #34d399 : #10b981;
    in property <color> decrease-color: ChartTheme.dark ? #fb7185 : #f43f5e;
    in property <color> total-color: ChartTheme.colors.length > 0 ? ChartTheme.colors[0] : #3b82f6;
    in property <string> increase-label: "Increase";
    in property <string> decrease-label: "Decrease";
    in property <string> total-label: "Total";
    in property <length> bar-radius: 0;
    in property <length> bar-border-width: 1px;
    // Opacity of the bar fills; the theme's `fill-opacity` by default.
    in property <float> fill-opacity: ChartTheme.fill-opacity;
    // Axis titles.
    in property <string> x-title;
    in property <string> y-title;
    // How values are written: a prefix and suffix, and a fixed number of
    // decimals (-1: automatic).
    in property <string> value-prefix;
    in property <string> value-suffix;
    in property <int> value-decimals: -1;

    // The step under the mouse, or selected with the arrow keys; -1 if none.
    out property <int> hovered-index: root.steps.length == 0 || fall.step <= 0 ? -1
        : touch.has-hover ? clamp(floor(touch.mouse-x / (fall.step * 1px)), 0, root.steps.length - 1)
        : keys.has-focus && root.key-index >= 0 ? min(root.key-index, root.steps.length - 1)
        : -1;

    callback step-clicked(index: int);

    accessible-role: image;
    accessible-label: root.title;

    private property <int> key-index: -1;
    private property <ChartFormat> format: {
        prefix: root.value-prefix,
        suffix: root.value-suffix,
        decimals: root.value-decimals,
    };
    private property <float> progress: 0;
    animate progress {
        duration: root.animated ? ChartTheme.animation-duration : 0ms;
        easing: ease-out-quart;
    }
    init => {
        progress = 1;
    }
    private property <[float]> totals: ChartEngine.waterfall-totals(root.steps);
    private property <ChartAxis> axis: ChartEngine.value-axis({
        kind: ChartKind.bar,
        datasets: [{ values: root.totals }],
        height: plot.height / 1px,
        begin-at-zero: true,
        font-size: ChartTheme.font-size / 1px,
        format: root.format,
    });
    private property <ChartWaterfallLayout> fall: ChartEngine.waterfall-layout({
        steps: root.steps,
        y-min: axis.min,
        y-max: axis.max,
        width: plot.width / 1px,
        height: plot.height / 1px,
        progress: root.progress,
    });
    private property <[ChartLegendItem]> legend: [
        { label: root.increase-label, color: root.increase-color },
        { label: root.decrease-label, color: root.decrease-color },
        { label: root.total-label, color: root.total-color },
    ];

    pure function bar-color(change: ChartChange) -> color {
        change == ChartChange.increase ? root.increase-color : change == ChartChange.decrease ? root.decrease-color : root.total-color
    }

    // A change with its sign, such as "+1,200", or a total.
    pure function step-text(index: int) -> string {
        root.steps[index].total ? ChartEngine.format-value(root.totals[index], root.format)
            : (root.steps[index].value > 0 ? "+" : "") + ChartEngine.format-value(root.steps[index].value, root.format)
    }

    min-width: 160px;
    min-height: 120px;
    preferred-width: 480px;
    preferred-height: 300px;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        if root.title != "": Text {
            text: root.title;
            color: ChartTheme.text-color;
            font-size: ChartTheme.title-font-size;
            font-weight: 600;
            horizontal-alignment: center;
        }

        LegendFrame {
            vertical-stretch: 1;
            items: root.legend;
            show-legend: root.show-legend;
            position: root.legend-position;

            frame := Rectangle {
                horizontal-stretch: 1;

                property <length> y-title-space: root.y-title != "" ? ChartTheme.font-size * 1.6 : 0px;
                property <length> x-title-space: root.x-title != "" ? ChartTheme.font-size * 1.8 : 0px;

                plot := Rectangle {
                    // Tick labels are mostly digits, about 0.6em wide each (the
                    // axis depends on the plot height, so they can't be measured).
                    x: axis.widest-label.character-count * ChartTheme.font-size * 0.62 + 8px;
                    y: frame.y-title-space + ChartTheme.font-size * 0.75;
                    width: max(0px, parent.width - self.x - 12px);
                    height: max(0px, parent.height - self.y - ChartTheme.font-size * 2 - frame.x-title-space);

                    for tick in axis.ticks: Rectangle {
                        y: tick.pos * 1px - 0.5px;
                        height: 1px;
                        background: ChartTheme.grid-color;
                    }
                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: ChartTheme.axis-color;
                    }
                    Rectangle {
                        y: parent.height - 0.5px;
                        height: 1px;
                        background: ChartTheme.axis-color;
                    }

                    if root.hovered-index >= 0: Rectangle {
                        x: root.hovered-index * fall.step * 1px;
                        width: fall.step * 1px;
                        background: ChartTheme.grid-color;
                    }

                    if root.show-connectors: Path {
                        viewbox-width: plot.width / 1px;
                        viewbox-height: plot.height / 1px;
                        width: plot.width;
                        height: plot.height;
                        fit: fill;
                        commands: fall.connectors;
                        stroke: ChartTheme.axis-color;
                        stroke-width: 1px;
                        stroke-line-cap: butt;
                    }

                    for bar in fall.bars: Rectangle {
                        property <color> fill: root.bar-color(bar.change);
                        x: bar.x * 1px;
                        y: bar.y * 1px;
                        width: bar.width * 1px;
                        height: bar.height * 1px;
                        background: self.fill.with-alpha(root.hovered-index == bar.index ? min(1, root.fill-opacity + 0.3) : root.fill-opacity);
                        border-radius: root.bar-radius;
                        border-color: self.fill;
                        border-width: root.bar-border-width;
                        animate background { duration: 120ms; }
                        animate y, height {
                            duration: root.animated && root.progress >= 1 ? 400ms : 0ms;
                            easing: ease-out;
                        }
                    }

                    if root.show-values: Rectangle {
                        for bar in fall.bars: Text {
                            // Above rising bars and totals, below falling ones.
                            property <bool> below: bar.change == ChartChange.decrease;
                            x: (bar.x + bar.width / 2) * 1px - self.preferred-width / 2;
                            y: self.below ? (bar.y + bar.height) * 1px + 2px : bar.y * 1px - self.preferred-height - 2px;
                            text: root.step-text(bar.index);
                            color: ChartTheme.text-color;
                            font-size: ChartTheme.font-size * 0.9;
                            opacity: root.progress;
                        }
                    }
                }

                for tick in axis.ticks: Text {
                    x: 0;
                    width: plot.x - 8px;
                    y: plot.y + tick.pos * 1px - self.height / 2;
                    text: tick.label;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    horizontal-alignment: right;
                }

                for step[i] in root.steps: Text {
                    x: plot.x + i * fall.step * 1px;
                    y: plot.y + plot.height + 6px;
                    width: fall.step * 1px;
                    text: step.label;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    font-weight: step.total ? 600 : 400;
                    horizontal-alignment: center;
                    overflow: elide;
                }

                if root.y-title != "": Text {
                    x: 0;
                    y: 0;
                    text: root.y-title;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    font-weight: 600;
                }

                if root.x-title != "": Text {
                    x: plot.x + (plot.width - self.width) / 2;
                    y: parent.height - self.height;
                    text: root.x-title;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    font-weight: 600;
                }

                // Keyboard: the arrow keys move through the steps, Enter
                // clicks the selected one.
                keys := FocusScope {
                    x: plot.x;
                    y: plot.y;
                    width: plot.width;
                    height: plot.height;
                    key-pressed(event) => {
                        let count = root.steps.length;
                        if count == 0 {
                            return reject;
                        }
                        let current = root.key-index < 0 ? 0 : min(root.key-index, count - 1);
                        if event.text == Key.RightArrow || event.text == Key.DownArrow {
                            root.key-index = root.key-index < 0 ? 0 : mod(current + 1, count);
                        } else if event.text == Key.LeftArrow || event.text == Key.UpArrow {
                            root.key-index = mod(current - 1 + count, count);
                        } else if event.text == Key.Home {
                            root.key-index = 0;
                        } else if event.text == Key.End {
                            root.key-index = count - 1;
                        } else if event.text == Key.Return && root.key-index >= 0 {
                            root.step-clicked(current);
                        } else {
                            return reject;
                        }
                        accept
                    }

                    touch := TouchArea {
                        clicked => {
                            keys.focus();
                            if root.hovered-index >= 0 {
                                root.key-index = root.hovered-index;
                                root.step-clicked(root.hovered-index);
                            }
                        }
                    }
                }

                if keys.has-focus: Rectangle {
                    x: plot.x - 3px;
                    y: plot.y - 3px;
                    width: plot.width + 6px;
                    height: plot.height + 6px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: ChartTheme.axis-color;
                }

                if root.show-tooltip && root.hovered-index >= 0 && root.hovered-index < fall.bars.length: Rectangle {
                    property <ChartWaterfallBar> bar: fall.bars[root.hovered-index];
                    property <length> anchor-x: plot.x + (self.bar.x + self.bar.width) * 1px;
                    x: self.anchor-x + 10px + self.width > frame.width ? max(0px, plot.x + self.bar.x * 1px - 10px - self.width) : self.anchor-x + 10px;
                    y: clamp(plot.y + (self.bar.y + self.bar.height / 2) * 1px - self.height / 2, 0px, max(0px, frame.height - self.height));
                    width: self.preferred-width;
                    height: self.preferred-height;
                    background: ChartTheme.tooltip-background;
                    border-radius: 6px;

                    VerticalLayout {
                        padding: 6px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        Text {
                            text: root.steps[bar.index].label;
                            color: ChartTheme.tooltip-text;
                            font-size: ChartTheme.font-size;
                            font-weight: 700;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    background: root.bar-color(bar.change);
                                    border-color: ChartTheme.tooltip-text;
                                    border-width: 1px;
                                }
                            }
                            Text {
                                text: root.steps[bar.index].total ? root.total-label + ": " + root.step-text(bar.index)
                                    : root.step-text(bar.index);
                                color: ChartTheme.tooltip-text;
                                font-size: ChartTheme.font-size;
                            }
                        }
                        if !root.steps[bar.index].total: Text {
                            text: "Running total: " + ChartEngine.format-value(root.totals[bar.index], root.format);
                            color: ChartTheme.tooltip-text;
                            font-size: ChartTheme.font-size;
                        }
                    }
                }
            }
        }
    }
}
