import { ChartDataset, ChartEngine, ChartFormat, ChartRadarLayout } from "engine.slint";
import { ChartTheme } from "theme.slint";
import { ChartLegendPosition, LegendFrame } from "legend.slint";
import { Tooltip } from "tooltip.slint";

// A radar chart: one spoke per label, and
// one closed polygon per dataset.
export component RadarChart {
    in-out property <[ChartDataset]> datasets;
    in property <[string]> labels;
    in property <string> title;
    in property <bool> begin-at-zero: true;
    in property <bool> show-legend: true;
    in property <ChartLegendPosition> legend-position: ChartLegendPosition.top;
    in property <bool> show-tooltip: true;
    in property <bool> show-points: true;
    in property <bool> animated: true;
    // How values are written in tooltips: a prefix and suffix, and a fixed
    // number of decimals (-1: automatic).
    in property <string> value-prefix;
    in property <string> value-suffix;
    in property <int> value-decimals: -1;

    // The category (spoke) under the mouse, or selected with the arrow keys;
    // -1 if none.
    out property <int> hovered-index: touch.has-hover ? ChartEngine.radar-hit(radar, touch.mouse-x / 1px, touch.mouse-y / 1px)
        : keys.has-focus && root.key-index >= 0 && root.labels.length > 0 ? min(root.key-index, root.labels.length - 1)
        : -1;
    private property <int> key-index: -1;

    private property <ChartFormat> format: {
        prefix: root.value-prefix,
        suffix: root.value-suffix,
        decimals: root.value-decimals,
    };

    accessible-role: image;
    accessible-label: root.title;

    callback category-clicked(index: int);
    callback legend-toggled(index: int);

    private property <float> progress: 0;
    animate progress {
        duration: root.animated ? ChartTheme.animation-duration : 0ms;
        easing: ease-out-quart;
    }
    init => {
        progress = 1;
    }

    private property <ChartRadarLayout> radar: ChartEngine.radar-layout({
        locale: ChartTheme.locale,
        datasets: root.datasets,
        labels: root.labels,
        width: area.width / 1px,
        height: area.height / 1px,
        begin-at-zero: root.begin-at-zero,
        progress: root.progress,
        font-size: ChartTheme.font-size / 1px,
        palette: ChartTheme.colors,
    });

    min-width: 160px;
    min-height: 160px;
    preferred-width: 400px;
    preferred-height: 360px;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        if root.title != "": Text {
            text: root.title;
            color: ChartTheme.text-color;
            font-size: ChartTheme.title-font-size;
            font-weight: 600;
            horizontal-alignment: center;
        }

        LegendFrame {
            vertical-stretch: 1;
            items: ChartEngine.dataset-legend(root.datasets, ChartTheme.colors);
            show-legend: root.show-legend;
            position: root.legend-position;
            toggled(index) => {
                root.datasets[index].hidden = !root.datasets[index].hidden;
                root.legend-toggled(index);
            }

            area := Rectangle {
                horizontal-stretch: 1;

                Path {
                    x: -0.5px;
                    y: -0.5px;
                    width: area.width + 1px;
                    height: area.height + 1px;
                    viewbox-width: area.width / 1px;
                    viewbox-height: area.height / 1px;
                    fit: fill;
                    commands: radar.grid;
                    stroke: ChartTheme.grid-color;
                    stroke-width: 1px;
                }

                for series in radar.series: Path {
                    width: 100%;
                    height: 100%;
                    viewbox-width: area.width / 1px;
                    viewbox-height: area.height / 1px;
                    fit: fill;
                    commands: series.area;
                    fill: series.color.with-alpha(ChartTheme.fill-opacity);
                }

                for series in radar.series: Path {
                    x: -ChartTheme.line-width / 2;
                    y: -ChartTheme.line-width / 2;
                    width: area.width + ChartTheme.line-width;
                    height: area.height + ChartTheme.line-width;
                    viewbox-width: area.width / 1px;
                    viewbox-height: area.height / 1px;
                    fit: fill;
                    commands: series.line;
                    stroke: series.color;
                    stroke-width: ChartTheme.line-width;
                    stroke-line-join: round;
                }

                for series in radar.series: Rectangle {
                    for point in series.points: Rectangle {
                        property <length> radius: point.index == root.hovered-index ? ChartTheme.point-hover-radius : ChartTheme.point-radius;
                        visible: root.show-points || point.index == root.hovered-index;
                        x: point.x * 1px - self.radius;
                        y: point.y * 1px - self.radius;
                        width: self.radius * 2;
                        height: self.radius * 2;
                        border-radius: self.radius;
                        background: point.index == root.hovered-index ? series.color : series.color.with-alpha(ChartTheme.fill-opacity);
                        border-color: series.color;
                        border-width: 2px;
                    }
                }

                for tick in radar.ticks: Rectangle {
                    x: tick.x * 1px - self.width / 2;
                    y: tick.y * 1px - self.height / 2;
                    width: tick-label.preferred-width + 6px;
                    height: tick-label.preferred-height;
                    background: ChartTheme.background.transparentize(0.25);
                    border-radius: 2px;
                    tick-label := Text {
                        text: tick.text;
                        color: ChartTheme.text-color;
                        font-size: ChartTheme.font-size * 0.9;
                    }
                }

                for label[index] in radar.point-labels: Text {
                    x: label.x * 1px - self.width * label.align;
                    y: label.y * 1px - self.height * label.valign;
                    text: label.text;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    font-weight: index == root.hovered-index ? 700 : 400;
                }

                // Keyboard: the arrow keys move around the spokes, Enter clicks
                // the selected one.
                keys := FocusScope {
                    key-pressed(event) => {
                        let count = root.labels.length;
                        if count == 0 {
                            return reject;
                        }
                        let current = root.key-index < 0 ? 0 : min(root.key-index, count - 1);
                        if event.text == Key.RightArrow || event.text == Key.DownArrow {
                            root.key-index = root.key-index < 0 ? 0 : mod(current + 1, count);
                        } else if event.text == Key.LeftArrow || event.text == Key.UpArrow {
                            root.key-index = mod(current - 1 + count, count);
                        } else if event.text == Key.Home {
                            root.key-index = 0;
                        } else if event.text == Key.End {
                            root.key-index = count - 1;
                        } else if event.text == Key.Return && root.key-index >= 0 {
                            root.category-clicked(current);
                        } else {
                            return reject;
                        }
                        accept
                    }

                    touch := TouchArea {
                        clicked => {
                            keys.focus();
                            if root.hovered-index >= 0 {
                                root.key-index = root.hovered-index;
                                root.category-clicked(root.hovered-index);
                            }
                        }
                    }
                }

                if keys.has-focus: Rectangle {
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: ChartTheme.axis-color;
                }

                if root.show-tooltip && root.hovered-index >= 0 && radar.visible.length > 0: Tooltip {
                    // At the mouse, or at the selected spoke's label.
                    property <length> anchor-x: touch.has-hover ? touch.mouse-x : radar.point-labels[root.hovered-index].x * 1px;
                    property <length> anchor-y: touch.has-hover ? touch.mouse-y : radar.point-labels[root.hovered-index].y * 1px;
                    x: max(0px, min(self.anchor-x + 14px, area.width - self.width));
                    y: max(0px, min(self.anchor-y + 14px, area.height - self.height));
                    width: self.preferred-width;
                    height: self.preferred-height;
                    title: root.labels[root.hovered-index];
                    index: root.hovered-index;
                    datasets: root.datasets;
                    series: radar.series;
                    visible-datasets: radar.visible;
                format: root.format;
                }
            }
        }
    }
}
