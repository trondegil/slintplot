import { ChartAxis, ChartDataset, ChartDumbbellLayout, ChartEngine, ChartFormat, ChartKind, ChartLegendItem } from "engine.slint";
import { ChartTheme, ChartTexts } from "theme.slint";
import { ChartLegendPosition, LegendFrame } from "legend.slint";

// A dumbbell chart: one row per category, with a dot for each dataset's value
// and a bar joining the smallest to the largest, to compare two (or more)
// values per category, such as before and after.
export component DumbbellChart {
    in-out property <[ChartDataset]> datasets;
    in property <[string]> labels;
    in property <string> title;
    in property <bool> show-legend: true;
    in property <ChartLegendPosition> legend-position: ChartLegendPosition.top;
    in property <bool> show-tooltip: true;
    // Move the dots out from the middle when the chart appears.
    in property <bool> animated: true;
    // Start the value axis at zero.
    in property <bool> begin-at-zero: false;
    // Write each value next to its dot: the smallest on the left, the
    // largest on the right.
    in property <bool> show-values: false;
    in property <length> dot-radius: 6px;
    // The bar joining the dots.
    in property <length> bar-width: 4px;
    in property <color> bar-color: ChartTheme.grid-color.mix(ChartTheme.axis-color, 0.5);
    // Axis titles.
    in property <string> x-title;
    in property <string> y-title;
    // A fixed value axis from `min-value` to `max-value`, instead of fitting
    // the data.
    in property <bool> fixed-range: false;
    in property <float> min-value: 0;
    in property <float> max-value: 100;
    // A logarithmic value axis. Values that aren't positive are left out.
    in property <bool> logarithmic: false;
    // How values are written: a prefix and suffix, and a fixed number of
    // decimals (-1: automatic).
    in property <string> value-prefix;
    in property <string> value-suffix;
    in property <int> value-decimals: -1;

    // The category under the mouse, or selected with the arrow keys; -1 if none.
    out property <int> hovered-index: root.labels.length == 0 || bell.step <= 0 ? -1
        : touch.has-hover ? clamp(floor(touch.mouse-y / (bell.step * 1px)), 0, root.labels.length - 1)
        : keys.has-focus && root.key-index >= 0 ? min(root.key-index, root.labels.length - 1)
        : -1;

    callback category-clicked(index: int);
    callback legend-toggled(index: int);

    accessible-role: image;
    accessible-label: root.title;
    accessible-description: root.hovered-index >= 0 ? root.labels[root.hovered-index] : "";

    private property <int> key-index: -1;
    private property <ChartFormat> format: {
        prefix: root.value-prefix,
        suffix: root.value-suffix,
        decimals: root.value-decimals,
    };
    private property <float> progress: 0;
    animate progress {
        duration: root.animated ? ChartTheme.animation-duration : 0ms;
        easing: ease-out-quart;
    }
    init => {
        progress = 1;
    }
    private property <[ChartLegendItem]> legend: ChartEngine.dataset-legend(root.datasets, ChartTheme.colors);
    private property <ChartAxis> axis: ChartEngine.value-axis({
        locale: ChartTheme.locale,
        kind: ChartKind.line,
        datasets: root.datasets,
        height: plot.width / 1px,
        horizontal: true,
        labels: root.labels,
        begin-at-zero: root.begin-at-zero,
        font-size: ChartTheme.font-size / 1px,
        fixed: root.fixed-range,
        fixed-min: root.min-value,
        fixed-max: root.max-value,
        logarithmic: root.logarithmic,
        format: root.format,
        // Room for the values beside the outermost dots.
        grace: root.show-values ? 0.06 : 0,
    });
    private property <ChartDumbbellLayout> bell: ChartEngine.dumbbell-layout({
        datasets: root.datasets,
        count: root.labels.length,
        x-min: axis.min,
        x-max: axis.max,
        logarithmic: root.logarithmic,
        width: plot.width / 1px,
        height: plot.height / 1px,
        progress: root.progress,
        palette: ChartTheme.colors,
    });

    min-width: 160px;
    min-height: 120px;
    preferred-width: 480px;
    preferred-height: 300px;

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        if root.title != "": Text {
            text: root.title;
            color: ChartTheme.text-color;
            font-size: ChartTheme.title-font-size;
            font-weight: 600;
            horizontal-alignment: center;
        }

        LegendFrame {
            vertical-stretch: 1;
            items: root.legend;
            show-legend: root.show-legend;
            position: root.legend-position;
            toggled(index) => {
                root.datasets[index].hidden = !root.datasets[index].hidden;
                root.legend-toggled(index);
            }

            frame := Rectangle {
                horizontal-stretch: 1;

                // Measures the category labels, which don't depend on the chart size.
                label-measure := Text {
                    visible: false;
                    text: ChartEngine.widest-label(root.labels);
                    font-size: ChartTheme.font-size;
                }

                // The y title sits above the axis, so it needs no rotated text.
                property <length> y-title-space: root.y-title != "" ? ChartTheme.font-size * 1.6 : 0px;
                property <length> x-title-space: root.x-title != "" ? ChartTheme.font-size * 1.8 : 0px;

                plot := Rectangle {
                    x: label-measure.preferred-width + 10px;
                    y: frame.y-title-space + 4px;
                    // Room for half of the last value label on the right.
                    width: max(0px, parent.width - self.x - 20px);
                    height: max(0px, parent.height - self.y - ChartTheme.font-size * 2 - frame.x-title-space);

                    // Value tick positions count from the far end of the axis.
                    for tick in axis.ticks: Rectangle {
                        x: (plot.width / 1px - tick.pos) * 1px - 0.5px;
                        width: 1px;
                        background: ChartTheme.grid-color;
                    }
                    Rectangle {
                        x: 0;
                        width: 1px;
                        background: ChartTheme.axis-color;
                    }
                    Rectangle {
                        y: parent.height - 0.5px;
                        height: 1px;
                        background: ChartTheme.axis-color;
                    }

                    if root.hovered-index >= 0: Rectangle {
                        y: root.hovered-index * bell.step * 1px;
                        height: bell.step * 1px;
                        background: ChartTheme.grid-color;
                    }

                    for row in bell.rows: Rectangle {
                        x: row.from * 1px;
                        y: row.y * 1px - root.bar-width / 2;
                        width: (row.to - row.from) * 1px;
                        height: root.bar-width;
                        border-radius: root.bar-width / 2;
                        background: root.bar-color;
                    }

                    for dot in bell.dots: Rectangle {
                        property <length> r: root.hovered-index == dot.index ? root.dot-radius + 1px : root.dot-radius;
                        x: dot.x * 1px - self.r;
                        y: dot.y * 1px - self.r;
                        width: self.r * 2;
                        height: self.r * 2;
                        border-radius: self.r;
                        background: dot.color;
                        border-width: 2px;
                        border-color: ChartTheme.background;
                    }

                    if root.show-values: Rectangle {
                        for row in bell.rows: Rectangle {
                            // The smallest value left of its dot, the largest right.
                            Text {
                                x: row.from * 1px - root.dot-radius - 4px - self.preferred-width;
                                y: row.y * 1px - self.preferred-height / 2;
                                visible: row.to > row.from;
                                text: ChartEngine.format-value(ChartEngine.dumbbell-extent(root.datasets, row.index).min, root.format);
                                color: ChartTheme.text-color;
                                font-size: ChartTheme.font-size * 0.9;
                                opacity: root.progress;
                            }
                            Text {
                                x: row.to * 1px + root.dot-radius + 4px;
                                y: row.y * 1px - self.preferred-height / 2;
                                text: ChartEngine.format-value(ChartEngine.dumbbell-extent(root.datasets, row.index).max, root.format);
                                color: ChartTheme.text-color;
                                font-size: ChartTheme.font-size * 0.9;
                                opacity: root.progress;
                            }
                        }
                    }
                }

                for label[i] in root.labels: Text {
                    x: 0;
                    width: plot.x - 10px;
                    y: plot.y + (i + 0.5) * bell.step * 1px - self.height / 2;
                    text: label;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    horizontal-alignment: right;
                }

                for tick in axis.ticks: Text {
                    x: plot.x + (plot.width / 1px - tick.pos) * 1px - self.width / 2;
                    y: plot.y + plot.height + 6px;
                    text: tick.label;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                }

                if root.y-title != "": Text {
                    x: 0;
                    y: 0;
                    text: root.y-title;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    font-weight: 600;
                }

                if root.x-title != "": Text {
                    x: plot.x + (plot.width - self.width) / 2;
                    y: parent.height - self.height;
                    text: root.x-title;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    font-weight: 600;
                }

                // Keyboard: the arrow keys move through the categories, Enter
                // clicks the selected one.
                keys := FocusScope {
                    x: plot.x;
                    y: plot.y;
                    width: plot.width;
                    height: plot.height;
                    key-pressed(event) => {
                        let count = root.labels.length;
                        if count == 0 {
                            return reject;
                        }
                        let current = root.key-index < 0 ? 0 : min(root.key-index, count - 1);
                        if event.text == Key.DownArrow || event.text == Key.RightArrow {
                            root.key-index = root.key-index < 0 ? 0 : mod(current + 1, count);
                        } else if event.text == Key.UpArrow || event.text == Key.LeftArrow {
                            root.key-index = mod(current - 1 + count, count);
                        } else if event.text == Key.Home {
                            root.key-index = 0;
                        } else if event.text == Key.End {
                            root.key-index = count - 1;
                        } else if event.text == Key.Return && root.key-index >= 0 {
                            root.category-clicked(current);
                        } else {
                            return reject;
                        }
                        accept
                    }

                    touch := TouchArea {
                        clicked => {
                            keys.focus();
                            if root.hovered-index >= 0 {
                                root.key-index = root.hovered-index;
                                root.category-clicked(root.hovered-index);
                            }
                        }
                    }
                }

                if keys.has-focus: Rectangle {
                    x: plot.x - 3px;
                    y: plot.y - 3px;
                    width: plot.width + 6px;
                    height: plot.height + 6px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: ChartTheme.axis-color;
                }

                if root.show-tooltip && root.hovered-index >= 0: Rectangle {
                    property <int> index: root.hovered-index;
                    property <length> anchor-y: plot.y + (self.index + 0.5) * bell.step * 1px;
                    property <length> anchor-x: touch.has-hover ? plot.x + touch.mouse-x : plot.x + plot.width / 2;
                    x: self.anchor-x + 14px + self.width > frame.width ? max(0px, self.anchor-x - 14px - self.width) : self.anchor-x + 14px;
                    y: clamp(self.anchor-y - self.height / 2, 0px, max(0px, frame.height - self.height));
                    width: self.preferred-width;
                    height: self.preferred-height;
                    background: ChartTheme.tooltip-background;
                    border-radius: 6px;

                    VerticalLayout {
                        padding: 6px;
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 4px;
                        Text {
                            text: root.labels[index];
                            color: ChartTheme.tooltip-text;
                            font-size: ChartTheme.font-size;
                            font-weight: 700;
                        }
                        for ds[d] in root.datasets: HorizontalLayout {
                            visible: !ds.hidden;
                            height: ds.hidden ? 0px : self.preferred-height;
                            spacing: 6px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 10px;
                                    height: 10px;
                                    background: root.legend[d].color;
                                    border-color: ChartTheme.tooltip-text;
                                    border-width: 1px;
                                }
                            }
                            Text {
                                text: ds.label + ": " + ChartEngine.format-value(ds.values[index], root.format);
                                color: ChartTheme.tooltip-text;
                                font-size: ChartTheme.font-size;
                            }
                        }
                        // With two datasets: the change from the first to the second.
                        if root.datasets.length == 2 && !root.datasets[0].hidden && !root.datasets[1].hidden: Text {
                            property <float> change: root.datasets[1].values[index] - root.datasets[0].values[index];
                            text: ChartTexts.change + ": " + (self.change > 0 ? "+" : "") + ChartEngine.format-value(self.change, root.format);
                            color: ChartTheme.tooltip-text;
                            font-size: ChartTheme.font-size;
                        }
                    }
                }
            }
        }
    }
}
