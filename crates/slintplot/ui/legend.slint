import { ChartLegendItem } from "engine.slint";
import { ChartTheme } from "theme.slint";

// Where a chart shows its legend.
export enum ChartLegendPosition { top, bottom, left, right }

// Chart legend. Clicking an entry calls `toggled`; the chart hides or shows
// the matching dataset or slice.
export component Legend {
    in property <[ChartLegendItem]> items;
    // Stack the entries (for legends left or right of a chart).
    in property <bool> vertical;
    callback toggled(index: int);

    // Wraps onto more lines when the entries don't fit.
    FlexboxLayout {
        alignment: center;
        flex-direction: root.vertical ? FlexboxLayoutDirection.column : FlexboxLayoutDirection.row;
        spacing-horizontal: 16px;
        spacing-vertical: 4px;
        for item[i] in root.items: Rectangle {
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 10px;
                        background: item.color.with-alpha(ChartTheme.fill-opacity);
                        border-color: item.color;
                        border-width: 2px;
                        opacity: item.hidden ? 0.4 : 1;
                    }
                }
                Text {
                    text: item.label;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    vertical-alignment: center;
                    opacity: item.hidden ? 0.5 : 1;
                    // Strike-through for hidden entries.
                    Rectangle {
                        visible: item.hidden;
                        y: (parent.height - self.height) / 2;
                        height: 1px;
                        background: ChartTheme.text-color;
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled(i);
                }
            }
        }
    }
}

// Places a legend above, below, left or right of its children (the chart).
export component LegendFrame {
    in property <[ChartLegendItem]> items;
    in property <bool> show-legend: true;
    in property <ChartLegendPosition> position: ChartLegendPosition.top;
    // Keep the legend next to what the chart draws, instead of at the edge:
    // charts whose shape doesn't fill their area, such as a pie in a wide
    // area, say how much empty space it leaves on each side, and the legend
    // moves into the space on its side. The layout is the same either way.
    in property <bool> attached: true;
    in property <length> slack-top;
    in property <length> slack-bottom;
    in property <length> slack-left;
    in property <length> slack-right;
    callback toggled(index: int);

    VerticalLayout {
        spacing: 8px;
        if root.show-legend && root.position == ChartLegendPosition.top: Rectangle {
            // Above the chart, so that clicks on the moved legend reach it.
            z: 1;
            vertical-stretch: 0;
            min-height: top-legend.min-height;
            preferred-height: top-legend.preferred-height;
            max-height: top-legend.preferred-height;
            top-legend := Legend {
                y: root.attached ? max(0px, root.slack-top) : 0px;
                width: parent.width;
                height: parent.height;
                items: root.items;
                toggled(index) => {
                    root.toggled(index);
                }
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            if root.show-legend && root.position == ChartLegendPosition.left: VerticalLayout {
                z: 1;
                alignment: center;
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: left-legend.min-width;
                    preferred-width: left-legend.preferred-width;
                    max-width: left-legend.preferred-width;
                    min-height: left-legend.min-height;
                    preferred-height: left-legend.preferred-height;
                    left-legend := Legend {
                        x: root.attached ? max(0px, root.slack-left) : 0px;
                        width: parent.width;
                        height: parent.height;
                        vertical: true;
                        items: root.items;
                        toggled(index) => {
                            root.toggled(index);
                        }
                    }
                }
            }
            @children
            if root.show-legend && root.position == ChartLegendPosition.right: VerticalLayout {
                alignment: center;
                Rectangle {
                    horizontal-stretch: 0;
                    min-width: right-legend.min-width;
                    preferred-width: right-legend.preferred-width;
                    max-width: right-legend.preferred-width;
                    min-height: right-legend.min-height;
                    preferred-height: right-legend.preferred-height;
                    right-legend := Legend {
                        x: root.attached ? -max(0px, root.slack-right) : 0px;
                        width: parent.width;
                        height: parent.height;
                        vertical: true;
                        items: root.items;
                        toggled(index) => {
                            root.toggled(index);
                        }
                    }
                }
            }
        }
        if root.show-legend && root.position == ChartLegendPosition.bottom: Rectangle {
            vertical-stretch: 0;
            min-height: bottom-legend.min-height;
            preferred-height: bottom-legend.preferred-height;
            max-height: bottom-legend.preferred-height;
            bottom-legend := Legend {
                y: root.attached ? -max(0px, root.slack-bottom) : 0px;
                width: parent.width;
                height: parent.height;
                items: root.items;
                toggled(index) => {
                    root.toggled(index);
                }
            }
        }
    }
}
