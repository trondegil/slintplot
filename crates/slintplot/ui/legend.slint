import { ChartLegendItem } from "engine.slint";
import { ChartTheme } from "theme.slint";

// Where a chart shows its legend.
export enum ChartLegendPosition { top, bottom, left, right }

// Chart legend. Clicking an entry calls `toggled`; the chart hides or shows
// the matching dataset or slice.
export component Legend {
    in property <[ChartLegendItem]> items;
    // Stack the entries (for legends left or right of a chart).
    in property <bool> vertical;
    // How solid the swatches are filled: the chart's own fill opacity, so
    // that a swatch has the colour of what it stands for.
    in property <float> fill-opacity: ChartTheme.fill-opacity;
    callback toggled(index: int);

    // Wraps onto more lines when the entries don't fit.
    FlexboxLayout {
        alignment: center;
        flex-direction: root.vertical ? FlexboxLayoutDirection.column : FlexboxLayoutDirection.row;
        spacing-horizontal: 16px;
        spacing-vertical: 4px;
        for item[i] in root.items: Rectangle {
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 10px;
                        background: item.color.with-alpha(root.fill-opacity);
                        border-color: item.color;
                        border-width: 2px;
                        opacity: item.hidden ? 0.4 : 1;
                    }
                }
                Text {
                    text: item.label;
                    color: ChartTheme.text-color;
                    font-size: ChartTheme.font-size;
                    vertical-alignment: center;
                    opacity: item.hidden ? 0.5 : 1;
                    // Strike-through for hidden entries.
                    Rectangle {
                        visible: item.hidden;
                        y: (parent.height - self.height) / 2;
                        height: 1px;
                        background: ChartTheme.text-color;
                    }
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.toggled(i);
                }
            }
        }
    }
}

// Places a legend above, below, left or right of its children (the chart).
export component LegendFrame {
    in property <[ChartLegendItem]> items;
    in property <bool> show-legend: true;
    in property <ChartLegendPosition> position: ChartLegendPosition.top;
    // How solid the swatches are filled: charts with a `fill-opacity` of
    // their own pass it on.
    in property <float> fill-opacity: ChartTheme.fill-opacity;
    // Keep the legend next to what the chart draws, instead of at the edge:
    // charts whose shape doesn't fill their area, such as a pie in a wide
    // area, say how much empty space it leaves on each side, and the legend
    // moves into the space on its side. The layout is the same either way.
    in property <bool> attached: true;
    in property <length> slack-top;
    in property <length> slack-bottom;
    in property <length> slack-left;
    in property <length> slack-right;
    callback toggled(index: int);

    // The legend in the layout keeps its room exactly as without
    // `attached`, so the chart's size doesn't depend on where the legend is
    // drawn. When attached, that one is invisible (it still takes its room)
    // and a copy outside the layout is drawn moved by the slack. The copy
    // depends on the layout, never the other way round, so the chart is laid
    // out once.
    VerticalLayout {
        spacing: 8px;
        if root.show-legend && root.position == ChartLegendPosition.top: Legend {
            visible: !root.attached;
            items: root.items;
            fill-opacity: root.fill-opacity;
            toggled(index) => {
                root.toggled(index);
            }
        }
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;
            if root.show-legend && root.position == ChartLegendPosition.left: VerticalLayout {
                alignment: center;
                Legend {
                    visible: !root.attached;
                    vertical: true;
                    items: root.items;
                    fill-opacity: root.fill-opacity;
                    toggled(index) => {
                        root.toggled(index);
                    }
                }
            }
            @children
            if root.show-legend && root.position == ChartLegendPosition.right: VerticalLayout {
                alignment: center;
                Legend {
                    visible: !root.attached;
                    vertical: true;
                    items: root.items;
                    fill-opacity: root.fill-opacity;
                    toggled(index) => {
                        root.toggled(index);
                    }
                }
            }
        }
        if root.show-legend && root.position == ChartLegendPosition.bottom: Legend {
            visible: !root.attached;
            items: root.items;
            fill-opacity: root.fill-opacity;
            toggled(index) => {
                root.toggled(index);
            }
        }
    }

    // The moved copies, over the chart so that their clicks reach them.
    if root.attached && root.show-legend && (root.position == ChartLegendPosition.top || root.position == ChartLegendPosition.bottom): Legend {
        x: 0px;
        width: root.width;
        height: self.preferred-height;
        y: root.position == ChartLegendPosition.top
            ? max(0px, root.slack-top)
            : root.height - self.height - max(0px, root.slack-bottom);
        items: root.items;
        fill-opacity: root.fill-opacity;
        toggled(index) => {
            root.toggled(index);
        }
    }
    if root.attached && root.show-legend && (root.position == ChartLegendPosition.left || root.position == ChartLegendPosition.right): Legend {
        vertical: true;
        width: self.preferred-width;
        height: self.preferred-height;
        x: root.position == ChartLegendPosition.left
            ? max(0px, root.slack-left)
            : root.width - self.width - max(0px, root.slack-right);
        y: (root.height - self.height) / 2;
        items: root.items;
        fill-opacity: root.fill-opacity;
        toggled(index) => {
            root.toggled(index);
        }
    }
}
